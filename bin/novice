#!/usr/bin/env bash
# The agent loop on one repository. Each step either starts the oldest open issue labeled agent or revises the open
# agent PR, and the script keeps stepping until it's Brad's turn: a PR waiting for his review, the day's runs used up,
# or nothing to do. Run it again, by hand or from a timer, after Brad acts.
#
#   novice REPO [--dry-run]     REPO names a settings file in repos/; --dry-run says what the next step would be and stops
#
# Limits: one agent PR open at a time; RUNS_PER_DAY worker runs a day; on each PR one automatic revision (a failed CI
# run or a blocking review) and up to BRAD_REVISIONS more, each started by Brad choosing "Request changes" on the PR.
# A failed CI run is rerun once before it counts, and a test that passes on the rerun is reported as flaky.
# A change over max_lines (lib/tower.sh) isn't opened or pushed; the issue needs splitting. When it's Brad's turn on a
# PR, the loop leaves a one-line summary and labels it needs-brad if he has to read it closely.
# The worker runs in bin/sandbox with its own Claude token; this script pushes and talks to GitHub as brads-agents.
set -euo pipefail

. "$(dirname "$(realpath "$0")")/../lib/tower.sh"
load_settings "${1:-}"
shift
repo_dir=$clone
bin=$tower/bin
log=$tower/log.md
model=claude-sonnet-5-5
budget=3
RUNS_PER_DAY=10
BRAD_REVISIONS=2
# What the PR's review check says from the push until the reviewer starts, so it doesn't read as waiting on Brad.
review_waiting="Automated reviewer: runs once CI finishes, not Brad's review"
denied=("Bash(git push*)" "Bash(gh *)" "Bash(git remote*)" "Bash(git config*)" "Bash(curl *)")

dry_run=0
[ "${1:-}" = --dry-run ] && dry_run=1
say() { echo "$(date +%H:%M:%S) $*"; }
# Prints the arguments after SEP, separated by it.
join() { local sep=$1 out=$2 item; shift 2; for item in "$@"; do out+="$sep$item"; done; printf '%s' "$out"; }

mkdir -p "$state"
exec 9> "$state/lock"
flock -n 9 || { say "another novice run is going"; exit 0; }
GH_TOKEN=$(cat "$agent_token")
export GH_TOKEN
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cd "$repo_dir"

runs_today() { cat "$state/runs-$(date +%F)" 2>/dev/null | wc -l; }
count() { cat "$state/$1" 2>/dev/null || echo 0; }
bump() { echo $(($(count "$1") + 1)) > "$state/$1"; }

# A clean checkout of BRANCH at START, with dependencies installed inside the sandbox, since package.json may be the agent's.
# Siblings are brought to their main first, and are read-only to everything after.
checkout() {
	git fetch -q --prune origin
	git reset -q --hard && git clean -qfd
	git checkout -q -B "$1" "$2"
	refresh_siblings "$work/install.log" || { say "refreshing ${siblings[*]} failed:"; tail -5 "$work/install.log"; exit 1; }
	"$bin/sandbox" "$repo_dir" "${sandbox_args[@]}" "${sibling_args[@]}" -- "${setup[@]}" > "$work/install.log" 2>&1 || { say "${setup[*]} failed:"; tail -5 "$work/install.log"; exit 1; }
}

# Runs the worker on the prompt in $1, leaving Claude's JSON in $work/worker.json.
worker() {
	local claude_token
	claude_token=$(cat "$HOME/.config/novices/claude-token") || { say "no Claude token in ~/.config/novices/claude-token (claude setup-token)"; exit 1; }
	date +%T >> "$state/runs-$(date +%F)"
	CLAUDE_CODE_OAUTH_TOKEN=$claude_token timeout 1800 "$bin/sandbox" "$repo_dir" "${sandbox_args[@]}" "${sibling_args[@]}" -- \
		claude -p --model "$model" --effort medium --max-budget-usd "$budget" --output-format json \
		--strict-mcp-config --setting-sources project --no-session-persistence \
		--allowedTools "${allowed[@]}" --disallowedTools "${denied[@]}" < "$1" > "$work/worker.json" 2> "$work/worker.err" || true
	jq -e . "$work/worker.json" > /dev/null 2>&1 || echo '{"subtype":"crashed","num_turns":0,"total_cost_usd":0,"result":"The worker crashed or timed out."}' > "$work/worker.json"
	git reset -q --hard && git clean -qfd
	# A run that never got to work (a login or API error, a crash, the timeout) says nothing about the issue: stop here,
	# leaving the issue untried and the PR as it was.
	if jq -e '.subtype == "crashed" or (.subtype == "success" and .is_error == true)' "$work/worker.json" > /dev/null; then
		say "the worker failed before doing any work: $(result | head -c 300)"
		exit 1
	fi
	say "worker: $(jq -r '"\(.subtype), \(.num_turns) turns, est. $\(.total_cost_usd * 100 | round / 100)"' "$work/worker.json")"
}
result() { jq -r '.result // ""' "$work/worker.json"; }

# Saves what the log line for HEAD needs until its CI and review are known.
pending() { jq -n --arg what "$2" --arg pr "$3" '{what: $what, pr: $pr}' | jq -c --slurpfile w "$work/worker.json" \
	'. + {turns: $w[0].num_turns, cost: ($w[0].total_cost_usd * 100 | round / 100)}' > "$state/pending-$1"; }

checks_permitted() {
	[ "$(runs_today)" -lt "$RUNS_PER_DAY" ] && return 0
	say "$RUNS_PER_DAY worker runs used today; stopping until tomorrow"
	return 1
}

# Waits for the CI run on SHA and prints success or failure.
ci_result() {
	local id="" i
	for i in $(seq 40); do
		id=$(gh run list -R "$repo" --commit "$1" --workflow ci.yml --limit 1 --json databaseId -q '.[0].databaseId // empty')
		[ -n "$id" ] && break
		sleep 15
	done
	[ -n "$id" ] || { echo missing; return; }
	timeout 1500 gh run watch -R "$repo" "$id" --exit-status --interval 30 > /dev/null 2>&1 && echo success || echo "failure $id"
}

# The verdict in the reviewer's marker on PR $1 for head $2, or nothing.
marked_verdict() {
	gh pr view -R "$repo" "$1" --json comments -q '[.comments[] | select(.author.login == "'$agent'") | .body
		| capture("<!-- review-pr verdict=(?<v>[a-z]+) head=(?<h>[0-9a-f]+) -->") | select(.h == "'$2'") | .v] | last // empty'
}

# The reviewer's verdict on SHA, from its marker in the PR's comments; runs the reviewer if there's none yet.
review_verdict() {
	local verdict
	verdict=$(marked_verdict "$1" "$2")
	if [ -z "$verdict" ]; then
		[ "$dry_run" = 1 ] && { echo "not reviewed yet"; return; }
		"$bin/review-pr" "$repo_name" "$1" >&2 || true
		verdict=$(marked_verdict "$1" "$2")
	fi
	echo "${verdict:-failed}"
}

# The tests that failed in CI run $1, from Playwright's and node:test's output, one per line.
failed_tests() {
	gh run view -R "$repo" "$1" --log-failed 2> /dev/null | cut -f3- | sed -E 's/^[0-9TZ:.-]+ //' |
		sed -nE 's/^ *✘ +[0-9]+ +(\[[a-z]+\] › )?(.*) \([0-9.]+m?s\)$/\2/p; s/^not ok [0-9]+ - (.*)$/\1/p' | sort -u | head -5
}

# The tests that failed on SHA's first CI run and passed on its rerun, comma-separated; nothing if it didn't happen.
flaky_tests() {
	[ -f "$state/rerun-$1" ] && [ "${2%% *}" = success ] || return 0
	if [ -s "$state/rerun-$1" ]; then paste -sd, "$state/rerun-$1" | sed 's/,/, /g'; else echo "a step, not a named test"; fi
}

# Moves the log line saved for SHA into log.md, with its CI result $2 and review verdict $3.
log_pending() {
	[ -f "$state/pending-$1" ] || return 0
	jq -r --arg date "$(date +%F)" --arg ci "$2" --arg review "$3" \
		--arg name "$repo_name" '"| \($date) | \($name) | \(.what) | #\(.pr) | sonnet-5.5 medium | \(.turns) | $\(.cost) | \($ci) | \($review) | | |"' \
		"$state/pending-$1" >> "$log"
	rm "$state/pending-$1"
}

# The reviewer's latest comment on PR $1 for head $2.
review_comment() { gh pr view -R "$repo" "$1" --json comments -q '[.comments[] | select(.author.login == "'$agent'") | select(.body | contains("head='"$2"'"))] | last | .body // ""'; }

pr_state() { gh pr view -R "$repo" "$1" --json state -q .state; }

# Gives PR $1 the label $2, removing any other label with the same prefix (size:, vouch:).
set_label() {
	local pr=$1 want=$2 have found=0
	for have in $(gh pr view -R "$repo" "$pr" --json labels -q '.labels[].name | select(startswith("'"${want%%:*}"':"))'); do
		if [ "$have" = "$want" ]; then found=1; else gh api -X DELETE "repos/$repo/issues/$pr/labels/$have" > /dev/null; fi
	done
	[ "$found" = 1 ] || gh api -X POST "repos/$repo/issues/$pr/labels" -f "labels[]=$want" > /dev/null
}

# Ends the loop's turn on PR $1 at head $2 (CI $3, review $4): a one-line summary comment, once for each head and outcome,
# and the needs-brad label when it touches flagged files or safety code, changes files a test can't prove (docs), or the
# reviewer listed done conditions it couldn't verify. A head without those loses the label.
summarize() {
	local pr=$1 head=$2 ci=$3 verdict=$4 marker files lines flagged_list unprovable_list unverified parts=() reasons=()
	marker="<!-- tower summary head=$head ci=${ci%% *} review=$verdict -->"
	if gh pr view -R "$repo" "$pr" --json comments -q '.comments[] | select(.author.login == "'$agent'") | .body' | grep -qF "$marker"; then
		return 0
	fi
	git fetch -q origin main "pull/$pr/head"
	files=$(git diff --name-only "origin/main...$head")
	lines=$(diff_lines "$head")
	flagged_list=$(flagged_files <<< "$files" | paste -sd, | sed 's/,/, /g')
	unprovable_list=$(grep -E "$unprovable" <<< "$files" | grep -vxF -f <(flagged_files <<< "$files") | paste -sd, | sed 's/,/, /g' || true)
	# How many done conditions the reviewer listed as unverified: its list items, or 1 for a line of prose.
	unverified=$(review_comment "$pr" "$head" | awk '/^## Unverified/ { on = 1; next } /^(---|## )/ { on = 0 } on' | sed '/^[[:space:]]*$/d')
	if [ -z "$unverified" ] || [ "$unverified" = None. ]; then unverified=0
	else
		unverified=$(grep -cE '^[[:space:]]*([-*]|[0-9]+\.) ' <<< "$unverified" || true)
		[ "$unverified" -gt 0 ] || unverified=1
	fi

	local flaky
	flaky=$(flaky_tests "$head" "$ci")
	case ${ci%% *} in
		success) if [ -n "$flaky" ]; then parts+=("CI passed on a rerun (flaky: $flaky)"); else parts+=("CI passed"); fi ;;
		*) parts+=("CI failed") ;;
	esac
	case $verdict in pass) parts+=("review passed") ;; block) parts+=("review blocked") ;; *) parts+=("review didn't run") ;; esac
	parts+=("$lines lines")
	if [ -n "$flagged_list" ]; then parts+=("flagged: $flagged_list"); reasons+=("flagged files"); else parts+=("no flagged files"); fi
	if [ -n "$unprovable_list" ]; then parts+=("tests can't prove: $unprovable_list"); reasons+=("docs"); fi
	if [ "$unverified" -gt 0 ]; then parts+=("Unverified: $unverified (see the review)"); reasons+=("unverified done conditions"); else parts+=("Unverified: none"); fi

	local body
	body=$(join " · " "${parts[@]}")
	if [ "${#reasons[@]}" -gt 0 ]; then
		gh api -X POST "repos/$repo/issues/$pr/labels" -f 'labels[]=needs-brad' > /dev/null
		body="$body

Labeled needs-brad ($(join ", " "${reasons[@]}")): read those parts before approving."
	else
		gh api -X DELETE "repos/$repo/issues/$pr/labels/needs-brad" > /dev/null 2>&1 || true
	fi
	gh pr comment -R "$repo" "$pr" --body "$body
$marker" > /dev/null
	say "summary: $(head -1 <<< "$body")"
}

# One step on the open PR. Returns 0 if it pushed a revision (step again), 1 if it's Brad's turn.
step_pr() {
	local pr=$1 branch=$2 head=$3 issue ci verdict review_id feedback="" kind=""
	issue=$(gh pr view -R "$repo" "$pr" --json closingIssuesReferences -q '.closingIssuesReferences[0].number // empty')
	[ -n "$issue" ] || { say "PR #$pr doesn't close an issue, so it can't be reviewed or revised; over to Brad"; return 1; }
	say "PR #$pr (issue #$issue) at ${head:0:7}"
	if [ "$dry_run" = 0 ]; then
		git fetch -q origin main "pull/$pr/head"
		set_label "$pr" "$(size_label "$(diff_lines "$head")")"
		set_label "$pr" "vouch:$([ "$vouched" = 1 ] && echo trusted || echo unvouched)"
	fi
	ci=$(ci_result "$head"); say "CI: $ci"
	# A failure is rerun once before the agent is sent after it, since it may be a flaky test the PR didn't cause.
	if [ "${ci%% *}" = failure ] && [ ! -f "$state/rerun-$head" ] && [ "$(pr_state "$pr")" = OPEN ]; then
		if [ "$dry_run" = 1 ]; then
			say "would rerun the failed CI job once"
		else
			failed_tests "${ci#failure }" > "$state/rerun-$head"
			say "rerunning the failed CI job once, in case it's flaky: $(paste -sd, "$state/rerun-$head")"
			gh run rerun -R "$repo" "${ci#failure }" --failed > /dev/null || say "the rerun couldn't be started"
			for _ in $(seq 20); do
				[ "$(gh run view -R "$repo" "${ci#failure }" --json status -q .status)" != completed ] && break
				sleep 3
			done
			ci=$(ci_result "$head"); say "CI on the rerun: $ci"
		fi
	fi
	local flaky
	flaky=$(flaky_tests "$head" "$ci")
	[ -z "$flaky" ] || say "flaky: $flaky"
	verdict=$(review_verdict "$pr" "$head"); say "review: $verdict"

	if [ "$dry_run" = 0 ]; then log_pending "$head" "${ci%% *}${flaky:+ on a rerun (flaky: $flaky)}" "$verdict"; fi

	# Brad can merge or close it while CI or the reviewer runs.
	if [ "$(pr_state "$pr")" != OPEN ]; then say "PR #$pr is $(pr_state "$pr") now; moving on"; return 0; fi
	if [ "$ci" = missing ]; then say "no CI run appeared for ${head:0:7}; over to Brad"; return 1; fi

	# Brad's "Request changes" since the last one handled comes first.
	review_id=$(gh api "repos/$repo/pulls/$pr/reviews" -q '[.[] | select(.user.login == "'$owner'" and .state == "CHANGES_REQUESTED")] | last | .id // empty')
	if [ -n "$review_id" ] && [ "$review_id" != "$(cat "$state/pr-$pr.brad-handled" 2>/dev/null)" ]; then
		if [ "$(count "pr-$pr.brad-revisions")" -ge "$BRAD_REVISIONS" ]; then
			[ "$dry_run" = 1 ] || summarize "$pr" "$head" "$ci" "$verdict"
			say "Brad asked for changes, but this PR has had its $BRAD_REVISIONS revisions for him; over to Brad"; return 1
		fi
		kind=brad
		feedback="## Brad's review (he requested changes)
$(gh api "repos/$repo/pulls/$pr/reviews/$review_id" -q .body)
$(gh api "repos/$repo/pulls/$pr/reviews/$review_id/comments" -q '.[] | "\n- \(.path) line \(.line // .original_line): \(.body)"')"
	elif [ "$ci" != success ] || [ "$verdict" = block ]; then
		if [ "$(count "pr-$pr.auto-revisions")" -ge 1 ]; then
			[ "$dry_run" = 1 ] || summarize "$pr" "$head" "$ci" "$verdict"
			say "still CI $ci, review $verdict after the automatic revision; over to Brad"; return 1
		fi
		kind=auto
		if [ "${ci%% *}" = failure ]; then
			feedback="## CI failed
~~~
$(gh run view -R "$repo" "${ci#failure }" --log-failed 2>/dev/null | cut -f3- | tail -120 | cut -c1-300)
~~~"
		fi
		if [ "$verdict" = block ]; then
			feedback="$feedback

## An automated reviewer blocked it
It saw only the issue, the diff and the description, and it can be wrong. Act on findings you can confirm, and say why for any you don't.

$(review_comment "$pr" "$head")"
		fi
	else
		[ "$dry_run" = 1 ] || summarize "$pr" "$head" "$ci" "$verdict"
		say "CI passed and the review didn't block; waiting for Brad to approve and merge, or request changes"; return 1
	fi

	[ "$dry_run" = 1 ] && { say "would revise PR #$pr ($kind)"; return 1; }
	checks_permitted || return 1
	say "revising PR #$pr ($kind)"
	checkout "$branch" "origin/$branch"
	{
		echo "You're working on $repo_name in this checkout, on the branch $branch, which is pull request #$pr for the issue below. It needs a revision."
		echo
		echo "Read AGENTS.md first and follow it. Address the feedback below and nothing else. Run $check until it passes, then add new commits on this branch; don't amend or rebase. You can't push or use gh; that's done for you."
		echo
		echo "Your final answer is posted on the pull request: for each point, what you changed, or why you didn't."
		echo
		gh issue view -R "$repo" "$issue" --json title,body -q '"# Issue #'"$issue"': " + .title + "\n\n" + .body'
		echo
		echo "# Feedback"
		echo
		echo "$feedback"
	} > "$work/prompt.md"
	worker "$work/prompt.md"
	if [ "$kind" = brad ]; then bump "pr-$pr.brad-revisions"; echo "$review_id" > "$state/pr-$pr.brad-handled"; else bump "pr-$pr.auto-revisions"; fi
	local lines too_big=""
	lines=$(diff_lines HEAD)
	if [ "$lines" -gt "$max_lines" ]; then
		too_big="

Not pushed: with this revision the PR comes to $lines changed lines, over the $max_lines-line limit. It stays local on \`$branch\` in the agents' clone. Split the issue."
	fi
	gh pr comment -R "$repo" "$pr" --body "**Revision ($( [ "$kind" = brad ] && echo "for Brad's review" || echo "automatic: CI $ci, review $verdict"))**

$(result)$too_big" > /dev/null
	if [ "$(git rev-parse HEAD)" = "$head" ]; then say "the worker added no commits"; return 1; fi
	if [ -n "$too_big" ]; then say "the revision makes it $lines lines, over $max_lines; not pushed, over to Brad"; return 1; fi
	if [ "$(pr_state "$pr")" != OPEN ]; then
		say "PR #$pr was $(pr_state "$pr" | tr A-Z a-z) while the worker ran; its revision $(git rev-parse --short HEAD) stays local on $branch, not pushed"
		return 1
	fi
	pending "$(git rev-parse HEAD)" "#$issue revision ($kind)" "$pr"
	git push -q origin "HEAD:refs/heads/$branch" 2> /dev/null
	review_status "$(git rev-parse HEAD)" pending "$review_waiting"
	# gh pr list can still report the old head for a few seconds after a push.
	opened="$pr $branch $(git rev-parse HEAD)"
	return 0
}

# Starts the oldest open agent issue that hasn't been tried. Returns 0 if it opened a PR, 1 otherwise.
start_issue() {
	local issue title branch pr touchy lines
	issue=""
	for n in $(gh issue list -R "$repo" --label agent --state open --json number -q 'sort_by(.number) | .[].number'); do
		if [ -f "$state/issue-$n" ]; then say "skipping #$n, tried before: $(cat "$state/issue-$n") (remove $state/issue-$n to retry)"; continue; fi
		issue=$n; break
	done
	[ -n "$issue" ] || { say "no open agent issues left to start"; return 1; }
	title=$(gh issue view -R "$repo" "$issue" --json title -q .title)
	[ "$dry_run" = 1 ] && { say "would start #$issue: $title"; return 1; }
	checks_permitted || return 1
	branch=agent/issue-$issue
	say "starting #$issue: $title"
	checkout "$branch" origin/main
	{
		echo "You're working on $repo_name in this checkout, on the branch $branch, to resolve the GitHub issue below."
		echo
		echo "Read AGENTS.md first and follow it. Make the change the issue asks for and nothing else. Run $check until it passes. Then commit on this branch, with a commit message in prose as AGENTS.md says. You can't push or use gh; that's done for you after you finish."
		echo
		echo "Your final answer becomes the pull request's description. Write it as AGENTS.md says: what changed, how you checked it, and anything you weren't sure of. Don't add a Closes line; that's added for you. If you couldn't finish, say what stopped you and don't commit."
		echo
		gh issue view -R "$repo" "$issue" --json title,body -q '"# Issue #'"$issue"': " + .title + "\n\n" + .body'
	} > "$work/prompt.md"
	worker "$work/prompt.md"
	if [ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ]; then
		gh issue comment -R "$repo" "$issue" --body "**The agent didn't finish this, so there's no PR.**

$(result)" > /dev/null
		echo "no PR, $(date +%F)" > "$state/issue-$issue"
		jq -r --arg date "$(date +%F)" --arg what "#$issue $title" --arg name "$repo_name" \
			'"| \($date) | \($name) | \($what) | none | sonnet-5.5 medium | \(.num_turns) | $\(.total_cost_usd * 100 | round / 100) | | | | |"' "$work/worker.json" >> "$log"
		say "no commits; commented on #$issue"
		return 1
	fi
	lines=$(diff_lines HEAD)
	if [ "$lines" -gt "$max_lines" ]; then
		gh issue comment -R "$repo" "$issue" --body "**The change came to $lines changed lines, over the $max_lines-line limit, so there's no PR.** It stays local on \`$branch\` in the agents' clone. Split this issue into smaller ones. The agent's notes:

$(result)" > /dev/null
		echo "too big ($lines lines), $(date +%F)" > "$state/issue-$issue"
		jq -r --arg date "$(date +%F)" --arg what "#$issue $title" --arg name "$repo_name" --arg lines "$lines" \
			'"| \($date) | \($name) | \($what) | none, \($lines) lines | sonnet-5.5 medium | \(.num_turns) | $\(.total_cost_usd * 100 | round / 100) | | | | |"' "$work/worker.json" >> "$log"
		say "$lines lines, over $max_lines; no PR, commented on #$issue"
		return 1
	fi
	touchy=$(git diff --name-only origin/main...HEAD | flagged_files | paste -sd, | sed 's/,/, /g')
	{
		echo "Closes #$issue"
		echo
		[ -n "$touchy" ] && printf '> [!WARNING]\n> This PR changes files that steer CI, agents or dependencies, or safety code: %s\n\n' "$touchy"
		result
	} > "$work/body.md"
	git push -q -u origin "$branch" 2> /dev/null
	pr=$(gh pr create -R "$repo" --head "$branch" --base main --title "$title" --body-file "$work/body.md" | grep -oE '[0-9]+$')
	echo "PR #$pr, $(date +%F)" > "$state/issue-$issue"
	pending "$(git rev-parse HEAD)" "#$issue $title" "$pr"
	review_status "$(git rev-parse HEAD)" pending "$review_waiting"
	say "opened PR #$pr"
	opened="$pr $branch $(git rev-parse HEAD)"
	return 0
}

# PRs merged or closed before the loop came back to them still get their log line, with CI and the review as they stood.
if [ "$dry_run" = 0 ]; then
	for file in "$state"/pending-*; do
		[ -e "$file" ] || continue
		head=${file##*/pending-} pr=$(jq -r .pr "$file")
		pr_now=$(pr_state "$pr")
		[ "$pr_now" = OPEN ] && continue
		ci=$(gh run list -R "$repo" --commit "$head" --workflow ci.yml --limit 1 --json conclusion -q '.[0].conclusion // "none"')
		verdict=$(marked_verdict "$pr" "$head")
		log_pending "$head" "${ci:-none}" "${verdict:-none}, ${pr_now,,} before the loop came back"
		say "logged PR #$pr, ${pr_now,,} before the loop came back to it"
	done
fi

# Brad's own open PRs are trusted.
if [ "$dry_run" = 0 ]; then
	for n in $(gh pr list -R "$repo" --state open --json number,author,labels \
		-q '.[] | select(.author.login == "'$owner'" and ([.labels[].name] | index("vouch:trusted") | not)) | .number'); do
		set_label "$n" vouch:trusted
	done
fi

while true; do
	# Not --author, which goes through GitHub's search index and can miss a PR opened seconds ago.
	open=$(gh pr list -R "$repo" --state open --json number,headRefName,headRefOid,author -q '.[] | select(.author.login == "'$agent'") | "\(.number) \(.headRefName) \(.headRefOid)"')
	if [ "$(printf '%s' "$open" | grep -c .)" -gt 1 ]; then say "more than one agent PR is open; leaving it to Brad"; break; fi
	[ -n "${opened:-}" ] && { open=$opened; opened=""; }
	if [ -n "$open" ]; then
		# shellcheck disable=SC2086
		step_pr $open || break
	else
		start_issue || break
	fi
done
